GEMINI_API_KEY=your_api_key_here
# Generate a random shared secret; leave blank to deny webhook access until configured.
WEBHOOK_API_KEY=
PUBLIC_DEMO_ENABLED=false
PUBLIC_DEMO_MAX_REQUESTS=20
# Set a Gemini model available to your account that supports structured output.
GEMINI_MODEL=your_model_id_here
DATABASE_URL=postgresql://username:password@localhost:5432/customer_triage
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/your/webhook/path
